filters:
  - 'record_type == "run-card"'
properties:
  run:
    displayName: Run
  title:
    displayName: Title
  status:
    displayName: Status
  area:
    displayName: Area
  focus:
    displayName: Focus
  next_decision:
    displayName: Next decision
  product:
    displayName: Product
  threads:
    displayName: Learning threads
  workflow:
    displayName: Workflow
  run_type:
    displayName: Run type
  execution_kind:
    displayName: Execution
  date:
    displayName: Date
  file.mtime:
    displayName: Last modified
views:
  - type: cards
    name: "Runs at a glance"
    groupBy:
      property: note.area
      direction: ASC
    order:
      - note.run
  - type: table
    name: "Run register"
    groupBy:
      property: note.status
      direction: ASC
    order:
      - note.run
      - note.title
      - note.product
      - note.threads
      - note.workflow
      - note.execution_kind
      - note.date
